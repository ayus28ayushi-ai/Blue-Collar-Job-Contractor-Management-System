# we'll keep our password and stuff placeholder here so people know what to add in their real env file.
# our actual password and stuff will be in env file which wont get committed to github

DATABASE_URL="postgres://{your_username}:{your_password}@localhost:5432/{your_db_name}"

 

JWT_SECRET_KEY="{your-secret-jwt-key}"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GOOGLE_CLIENT_ID="{your-google-client-id}"

